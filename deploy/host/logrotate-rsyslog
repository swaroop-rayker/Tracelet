# Tracelet host baseline (ADR-0026). Installed as /etc/logrotate.d/rsyslog by
# `./scripts/tl host-setup`, replacing Debian's weekly rotation. rsyslog duplicates
# the journal, so little is kept: daily or at 100 MB, four compressed.
/var/log/syslog
/var/log/mail.log
/var/log/kern.log
/var/log/auth.log
/var/log/user.log
/var/log/cron.log
{
	rotate 4
	daily
	maxsize 100M
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
