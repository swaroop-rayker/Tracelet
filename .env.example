# ---------------------------------------------------------------------------
# Tracelet — environment configuration
#
#   cp .env.example .env    then edit the values marked REQUIRED.
#
# Every variable is documented. Secrets are never stored in the database and
# never committed (F14.AC5, F12.AC3).
#
# Variables marked [M1]..[M9] are not read until that milestone. They are
# listed now so the file is the complete reference from day one; leaving them
# blank is correct until then.
# ---------------------------------------------------------------------------

# === Core ==================================================================

# Deployment environment. Controls error verbosity and dev-only behaviour.
#   development | production
TRACELET_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
TRACELET_LOG_LEVEL=INFO

# Uvicorn workers under Gunicorn.
# 2 in production. Drop to 1 as the FIRST lever if memory gets tight
# (~110 MB freed) — see docs/private/06-PERFORMANCE-AND-MEMORY.md.
TRACELET_WEB_CONCURRENCY=2


# === Domain and TLS (ADR-0012, F13.AC5) ====================================

# The address Caddy serves. This single variable switches deployment mode:
#
#   localhost                 → local dev, Caddy internal CA (HTTPS works)
#   tracelet.example.com      → purchased-domain path  (SUPPORTED PATH)
#   tracelet.duckdns.org      → free-subdomain path    (DEGRADED MODE)
#
# The free-subdomain path cannot sit behind Cloudflare and therefore loses
# edge TLS, the CF-Ray colo geo signal, CF-IPCountry, L0 DDoS absorption and
# origin-IP hiding, and it retains the B4 browser-trust problem.
# See docs/KICKOFF.md §3 and docs/RISKS.md R10.
TRACELET_SITE_ADDRESS=localhost

# NOTE: there is deliberately no ACME contact-email setting. The address is
# optional, Let's Encrypt discontinued expiry notification emails in 2025, and an
# empty or placeholder value silently broke either the Caddy config or certificate
# issuance on a real domain. See docs/ERRORS.md E5.

# Is the origin behind the Cloudflare proxy?
# When true, the real client IP is taken from CF-Connecting-IP — but ONLY when
# the TCP peer is a verified Cloudflare address (F13.AC6). A forged header is
# never trusted. [M2]
TRACELET_BEHIND_CLOUDFLARE=false

# DEVELOPMENT ONLY (ADR-0025). Uncomment while `./scripts/tl tunnel` is used for a
# phone to reach this stack, so the phone's real address is recorded (M8 labelling).
# It trusts CF-Connecting-IP from the tunnel's own Docker network and nothing else.
# Settings refuse to load with it set when TRACELET_ENV is not development.
# TRACELET_DEV_TRUSTED_TUNNEL=172.31.254.0/29


# === Database ==============================================================
# The db container is initialised by db/init/*.sql, which creates the three
# roles (tracelet_app, tracelet_maint, tracelet_migrate) and the PostGIS
# extension — see docs/DATA_MODEL.md §12.

POSTGRES_DB=tracelet
POSTGRES_USER=tracelet
# REQUIRED. Superuser/owner password for the db container.
POSTGRES_PASSWORD=change-me-postgres

# REQUIRED. Password for tracelet_app — the role the API uses.
# Has no UPDATE/DELETE on audit_log, which is what makes the audit log
# append-only at the engine level (NFR5.AC5).
TRACELET_DB_APP_PASSWORD=change-me-app

# REQUIRED. Password for tracelet_maint — purge, backup, restore-verify.
TRACELET_DB_MAINT_PASSWORD=change-me-maint

# REQUIRED. Password for tracelet_migrate — DDL only, used by Alembic.
TRACELET_DB_MIGRATE_PASSWORD=change-me-migrate

# Connection URLs. Defaults resolve inside the compose network; override only
# if pointing at an external database.
TRACELET_DATABASE_URL=postgresql+asyncpg://tracelet_app:change-me-app@db:5432/tracelet
TRACELET_MIGRATE_DATABASE_URL=postgresql+psycopg://tracelet_migrate:change-me-migrate@db:5432/tracelet

# Connection pool. Bounded deliberately: the pool is rate-limit layer L3,
# providing backpressure instead of collapse (ADR-0010).
#
# The pool is PER PROCESS, so the real peak is POOL_MAX x WEB_CONCURRENCY. The
# budget below is checked at boot and a violation refuses to start:
#
#   10 x 2 workers = 20 peak,  24 max_connections - 4 reserved = 20 available
#
# The reserve exists so pg_dump, the restore-verify job and a psql session can
# still connect while the application pool is saturated -- which is precisely
# when a backup must not fail.
TRACELET_DB_POOL_MIN=5
TRACELET_DB_POOL_MAX=10

# Must match `max_connections` in docker-compose.yml. Mirrored here so the pool
# arithmetic is validated against reality rather than a magic number.
TRACELET_DB_MAX_CONNECTIONS=24
TRACELET_DB_RESERVED_CONNECTIONS=4


# === Secrets: OUT-OF-BAND BACKUP REQUIRED ==================================
#
# These are deliberately NOT in the database backup (ADR-0007, ADR-0014).
# Store them in a password manager or somewhere that is neither this VM nor
# the backup file. Restoring a dump WITHOUT them leaves every encrypted IP
# permanently unreadable and breaks all historical visitor_id linkage.
# See docs/private/07-OPERATIONS-PLAYBOOK.md and docs/RISKS.md R11.
#
# Generate each with:  openssl rand -hex 32

# Keys the capture page's enrichment nonce (F2.AC6), through a derived key used
# for nothing else. REQUIRED from M2: without it every visit is still recorded
# and redirected, but none can be enriched -- the sweeper finalises them all as
# server_only, and the log says why on every request. Rotating it only
# invalidates nonces minted in the last 60 seconds. (Admin sessions do NOT use
# it: they are opaque random tokens stored hashed, ADR-0008.) [M2]
TRACELET_SESSION_SECRET=

# AES-256-GCM key for visits.ip_enc, as a path to a 0400 file OUTSIDE the
# database volume. Loaded into process memory at boot, never written to the
# database, never logged, never returned by an API (F12.AC3). [M2]
TRACELET_IP_KEY_FILE=/run/secrets/ip_key

# The three HMAC peppers (ADR-0006). Three, not one, because a single
# identifier cannot serve both "recognise a returning visitor" and "spot one
# device across many networks".
#   STABLE   → ip_hmac (from M2) and visitor_id (from M4), domain-separated so
#              one pepper cannot produce the same value from two inputs.
#              REQUIRED from M2. Rotating it breaks returning-visitor history
#              and IP correlation across the rotation.
#   ROTATING → session_fp.   Rotated daily by design.
#   FP       → fingerprint_id. Excludes the IP, so proxy detection can fire.
TRACELET_PEPPER_STABLE=
TRACELET_PEPPER_ROTATING=
TRACELET_PEPPER_FP=


# === Telegram (F7, ADR-0008) ===============================================
# REQUIRED from M1. There is no email provider in this design, so Telegram is
# both the notification channel AND a password-recovery channel — which makes
# it security-critical (docs/RISKS.md R18).
# Obtain from @BotFather.

TRACELET_TELEGRAM_BOT_TOKEN=
TRACELET_TELEGRAM_OWNER_CHAT_ID=

# Hold non-high-priority notifications during this window, so 500 visits/day
# cannot become 500 night-time messages (F7.AC9). Local to the admin timezone.
TRACELET_QUIET_HOURS_START=23:00
TRACELET_QUIET_HOURS_END=07:00


# === Geolocation data sources (F4.AC5) =====================================
# Offline databases are the baseline; external lookups are extra consensus
# voters. All are toggleable at runtime from the System Health page. [M3]

# MaxMind GeoLite2-City + GeoLite2-ASN. Free account + licence key.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# IP2Location LITE DB11. Free account.
IP2LOCATION_TOKEN=

# IPinfo Lite. Free token.
IPINFO_TOKEN=

# DB-IP Lite and GeoNames need no signup, but are CC-BY:
# ATTRIBUTION IS REQUIRED on the privacy page (F2.AC13, docs/RISKS.md R13).

# Where the offline databases live. Gitignored; populated at runtime.
TRACELET_GEO_DATA_DIR=/data/geoip

# Third-party lookups from inference. true allows both of:
#   - ipwho.is (S9): sent the visitor's /24 network address, never the host;
#     cached by prefix, so a repeat network causes no outbound call.
#   - Nominatim: sent the coordinates of a visitor who had ALREADY granted
#     location, to find the street address. Nothing else about the visit.
# Approved at Gate 1 with per-source toggles and privacy-page disclosure; the
# privacy page states whichever applies. false keeps all estimation on this
# server. [M3]
TRACELET_EXTERNAL_GEO_ENABLED=true

# (Latency triangulation, source S10, was dropped in M3: it needs third-party
# requests from the capture page, which F2.AC12 forbids. SPEC section 11 row 12.)


# === Data lifecycle (F12.AC7, ADR-0014) ====================================
# Starting values only: the first read writes them to retention_policy, and
# from then on they are edited from the dashboard. Two retention clocks, on
# purpose: the encrypted IP expires long before the visit row does.

TRACELET_RETENTION_VISIT_DAYS=180
TRACELET_RETENTION_IP_DAYS=30
TRACELET_RETENTION_AUDIT_DAYS=365

# Rollup aggregates are NEVER purged. Retention costs detail, not history
# (NFR5.AC4).

# Days and hours on every chart are bucketed in this IANA zone (ADR-0016).
# After changing it, run: docker compose run --rm api tracelet analytics rebuild
TRACELET_REPORTING_TZ=Asia/Kolkata

TRACELET_BACKUP_DIR=/data/backups
TRACELET_BACKUP_DAILY_KEEP=7
TRACELET_BACKUP_WEEKLY_KEEP=4

# Warn on the dashboard when the last MANUAL off-VM download is older than
# this. The manual download is the only off-VM path (F12.AC11), so this nag is
# the mitigation for the highest-severity operational risk in the system.
TRACELET_BACKUP_DOWNLOAD_REMINDER_DAYS=7

# The nightly backup's local hour (in TRACELET_REPORTING_TZ). The monthly restore
# check runs on the 1st of the month, an hour later. Both need the one-time
# superuser setup on an existing volume: ./scripts/tl db-setup (ADR-0022).
TRACELET_BACKUP_HOUR=3


# === System health (F10) ===================================================
# The host's /proc and /sys, mounted read-only by docker-compose.yml, so the
# figures are the VM's and not the container's (F10.AC15). Leave as they are.
#TRACELET_HOST_PROC_PATH=/host/proc
#TRACELET_HOST_SYS_PATH=/host/sys

# Thresholds for the System Health warnings and the degradation banner.
TRACELET_DISK_WARN_PERCENT=85
TRACELET_DISK_CRITICAL_PERCENT=95
TRACELET_MEMORY_WARN_PERCENT=90
TRACELET_SWAP_WARN_PERCENT=50

# Load shedding (F15.AC6, ADR-0010 amendment): while the host's memory pressure
# ("some avg10" from /proc/pressure/memory, percent) is at or above this, visits
# are redirected without being captured. 0 turns it off. Without PSI, the
# swap-in rate below decides instead.
TRACELET_SHED_MEMORY_PRESSURE=20
TRACELET_SHED_SWAPIN_PAGES_PER_S=256
