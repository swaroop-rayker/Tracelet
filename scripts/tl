#!/usr/bin/env sh
# ---------------------------------------------------------------------------
# tl — the Tracelet task runner.
#
# This is the SINGLE implementation of every developer task. The Makefile is a
# thin wrapper that delegates here, so `make verify` and `./scripts/tl verify`
# always do exactly the same thing.
#
# Why a script rather than only a Makefile: the documented dev environment is
# Windows 11 + Docker via WSL (SPEC C5), and `make` is not present in Git Bash
# on a stock Windows host. POSIX sh runs in Git Bash, WSL and CI alike.
#
# Everything runs inside containers. No Python or Node is required on the host.
# ---------------------------------------------------------------------------
set -eu

cd "$(dirname "$0")/.."

DC="docker compose"
DCT="docker compose --profile tools"
API_RUN="$DCT run --rm --no-deps api-tools"
# Flags must precede the service name, and -T is needed whenever stdout is
# captured rather than attached to a terminal.
API_RUN_T="$DCT run --rm --no-deps -T api-tools"
API_RUN_DB="$DCT run --rm api-tools"
WEB_RUN="$DCT run --rm --no-deps web-tools"
# One-offs in the production image run as the `cli` service, never `api`: a run of `api`
# inherits its fixed address, which the running api holds (docs/ERRORS.md E80).
API_PROD="$DC run --rm cli"

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
grn()  { printf '\033[32m%s\033[0m\n' "$1"; }
ylw()  { printf '\033[33m%s\033[0m\n' "$1"; }
step() { printf '\n\033[1m── %s\033[0m\n' "$1"; }

require_env() {
    if [ ! -f .env ]; then
        red "No .env found."
        echo "  cp .env.example .env    then edit the values marked REQUIRED."
        exit 1
    fi
}

# --- tasks -----------------------------------------------------------------

task_bootstrap() {
    require_env
    if is_release_host; then
        # A release host never builds (ADR-0026): `tl deploy` has pulled the images,
        # started the stack and migrated. What is left is the first owner.
        if ! grep -q '^TRACELET_IMAGE_TAG=..*' .env; then
            red "Release host with no image yet. Run ./scripts/tl deploy first."
            exit 1
        fi
    else
        step "Building images"
        $DCT build
    fi
    step "Starting database"
    $DC up -d db
    step "Waiting for database to become healthy"
    task_waitdb
    step "Applying migrations"
    task_migrate
    step "Creating the first owner admin"
    # No password is set here, by design (F8.AC15): the command prints a one-time
    # enrollment URL and the invitee chooses their own. There is therefore no
    # default password anywhere in this system to forget to change.
    #
    # Runs in the PRODUCTION image, like migrations, so bootstrap exercises what
    # actually ships. Idempotent: re-running it against an existing owner issues a
    # fresh link rather than failing.
    if [ -z "${TRACELET_BOOTSTRAP_EMAIL:-}" ]; then
        ylw "Set TRACELET_BOOTSTRAP_EMAIL to create the first owner, e.g."
        ylw "  TRACELET_BOOTSTRAP_EMAIL=you@example.com ./scripts/tl bootstrap"
        ylw "Or run it directly:"
        ylw "  docker compose run --rm cli tracelet admin bootstrap --email you@example.com"
    else
        $API_PROD tracelet admin bootstrap \
            --email "$TRACELET_BOOTSTRAP_EMAIL" \
            --name "${TRACELET_BOOTSTRAP_NAME:-Owner}"
    fi
    grn "Bootstrap complete. Next: ./scripts/tl up"
}

task_waitdb() {
    i=0
    while [ "$i" -lt 60 ]; do
        if $DC exec -T db pg_isready -q -U "${POSTGRES_USER:-tracelet}" 2>/dev/null; then
            grn "Database ready."
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    red "Database did not become ready within 60s."
    $DC logs --tail=50 db
    exit 1
}

task_up()      { require_env; $DC up -d; grn "Up. https://${TRACELET_SITE_ADDRESS:-localhost}"; }
task_down()    { $DC down; }
task_logs()    { $DC logs -f "$@"; }
task_ps()      { $DC ps; }
task_psql()    { $DC exec db psql -U "${POSTGRES_USER:-tracelet}" -d "${POSTGRES_DB:-tracelet}"; }
task_shell()   { $API_RUN sh; }

# The restore check's one-time superuser setup (ADR-0022). db/init runs it on an
# empty volume; this applies it to an existing one. Idempotent.
task_db_setup() {
    require_env
    # MSYS_NO_PATHCONV: Git Bash would rewrite the container path into a Windows one.
    MSYS_NO_PATHCONV=1 $DC exec -T db bash /docker-entrypoint-initdb.d/02-restore-check.sh
}

# Migrations run in the PRODUCTION image, because that is the one that ships.
task_migrate() { require_env; $API_PROD alembic upgrade head; }

task_revision() {
    if [ $# -eq 0 ]; then red "Usage: tl revision \"message\""; exit 1; fi
    $API_RUN_DB alembic revision --autogenerate -m "$1"
}

task_fmt() {
    step "ruff format"
    $API_RUN ruff format src tests spikes
    step "ruff check --fix"
    $API_RUN ruff check --fix src tests spikes
    step "prettier --write"
    $WEB_RUN npx prettier --write "src/**/*.{ts,tsx,css}" "*.{json,js,cjs}"
}

# `verify` is the CI gate, run locally. Same checks, same order.
task_verify() {
    require_env
    failed=""

    step "1/14  ruff check"
    $API_RUN ruff check src tests spikes || failed="$failed ruff-check"

    step "2/14  ruff format --check"
    $API_RUN ruff format --check src tests spikes || failed="$failed ruff-format"

    step "3/14  mypy --strict"
    $API_RUN mypy src tests spikes || failed="$failed mypy"

    step "4/14  pytest unit"
    $API_RUN pytest tests/unit -q || failed="$failed pytest-unit"

    step "5/14  pytest integration (real PostgreSQL + PostGIS, never mocked)"
    $DC up -d db >/dev/null 2>&1 || true
    task_waitdb >/dev/null
    # The suite shares the dev database. A running api's scheduler would infer,
    # classify and roll up the suite's visits mid-test (docs/ERRORS.md E36), so it is
    # paused for the run and restarted afterwards.
    api_was_running="$($DC ps --status running -q api 2>/dev/null || true)"
    if [ -n "$api_was_running" ]; then
        echo "  pausing the running api container for the integration suite"
        $DC stop api >/dev/null 2>&1 || true
    fi
    $API_RUN_DB pytest tests/integration -q || failed="$failed pytest-integration"
    if [ -n "$api_was_running" ]; then
        $DC start api >/dev/null 2>&1 || true
    fi

    step "6/14  eslint"
    $WEB_RUN npx eslint src || failed="$failed eslint"

    step "7/14  prettier --check"
    $WEB_RUN npx prettier --check "src/**/*.{ts,tsx,css}" || failed="$failed prettier"

    step "8/14  tsc --noEmit"
    $WEB_RUN npx tsc --noEmit || failed="$failed tsc"

    step "9/14  vitest (dashboard: panel states, contrast, filters)"
    $WEB_RUN npx vitest run || failed="$failed vitest"

    step "10/14 accuracy gate (F14.AC12: the synthetic fixture, no database)"
    $API_RUN tracelet accuracy check --fixture tests/fixtures/accuracy/synthetic.json >/dev/null         || failed="$failed accuracy"

    step "11/14 OpenAPI -> TypeScript drift"
    task_openapi_check || failed="$failed openapi-drift"

    step "12/14 route-name guard (B6: content blockers match URL substrings)"
    $API_RUN pytest tests/unit/test_route_names.py -q || failed="$failed route-names"

    step "13/14 guard-private-docs"
    sh scripts/guard_private_docs.sh || failed="$failed guard-private-docs"

    step "14/14 docker build"
    $DCT build >/dev/null || failed="$failed docker-build"

    echo
    if [ -n "$failed" ]; then
        red "FAILED:$failed"
        exit 1
    fi
    grn "All 14 checks passed."
}

# Regenerate api/openapi.json and web/src/api/generated/schema.d.ts.
task_openapi() {
    # Written to a temp file and moved into place only on success. A direct
    # redirect truncates the committed artefact the instant the command starts, so
    # any downstream failure leaves an empty file that then looks like real drift.
    tmp="api/openapi.json.tmp"
    if ! $API_RUN_T python -m tracelet.cli.export_openapi > "$tmp"; then
        rm -f "$tmp"
        red "OpenAPI export failed."
        return 1
    fi
    mv "$tmp" api/openapi.json

    # Relative paths, resolved against the container working directory /work/web.
    # Absolute container paths must NOT be used here: Git Bash rewrites anything
    # shaped like a Unix absolute path into a Windows one before the argument ever
    # reaches docker. See docs/ERRORS.md E6.
    $WEB_RUN npx openapi-typescript ../api/openapi.json \
        -o src/api/generated/schema.d.ts
    grn "Regenerated. Commit both files."
}

# Fail if the committed artefacts differ from a fresh generation. One source of
# truth for the API contract (F14.AC9).
task_openapi_check() {
    task_openapi >/dev/null
    if ! git diff --quiet -- api/openapi.json web/src/api/generated/schema.d.ts; then
        red "OpenAPI drift: committed client does not match the API."
        red "Run: ./scripts/tl openapi   then commit the result."
        git --no-pager diff --stat -- api/openapi.json web/src/api/generated/schema.d.ts
        return 1
    fi
    return 0
}

# The development tunnel (ADR-0025): a Cloudflare quick tunnel to this stack, so a phone
# can reach it for M8's labelling. Development only; the address changes on every start.
task_tunnel() {
    require_env
    if ! grep -q '^TRACELET_DEV_TRUSTED_TUNNEL=' .env; then
        ylw "TRACELET_DEV_TRUSTED_TUNNEL is not set in .env: visits through the tunnel will"
        ylw "record the tunnel, not your phone's network. Set it (see .env.example), then"
        ylw "restart the api:  docker compose up -d api"
    fi
    $DC --profile tunnel up -d tunnel
    step "Waiting for the tunnel's address"
    i=0
    while [ $i -lt 45 ]; do
        url="$($DC --profile tunnel logs tunnel 2>/dev/null | grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' | tail -1 || true)"
        if [ -n "$url" ]; then
            grn "$url"
            echo "  Your links are at $url/r/<slug>. Stop with: ./scripts/tl tunnel-stop"
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    red "No address yet. See: docker compose --profile tunnel logs tunnel"
    exit 1
}

task_tunnel_stop() { $DC --profile tunnel rm -sf tunnel; grn "Tunnel stopped."; }

# --- release and deploy (ADR-0026) -----------------------------------------
#
# The production VM never builds. `release` runs on the owner's PC: it builds both
# images from a clean `git archive` of HEAD, proves no local TLS-inspection root is in
# them, and (with --push) pushes them to Docker Hub. `deploy` runs on the VM, in a
# checkout of the same commit, and pulls them. A release host is one whose .env names
# an image tag; there, COMPOSE_FILE in .env adds docker-compose.prod.yml to every
# compose command.

IMAGE_REPO="${TRACELET_IMAGE_REPO:-swarooprayker}"

is_release_host() { [ -f .env ] && grep -q '^TRACELET_IMAGE_TAG=' .env; }

# A path docker.exe on Windows can read; unchanged elsewhere.
native_path() {
    if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s' "$1"; fi
}

# Fails if a release image carries a local root (ADR-0026, item 2). Two checks: no
# extra anchor installed, and no trust file anywhere in the image containing any
# local root's body. The second is the one that matters; it is what catches an
# anchor appended to certifi's bundle.
release_check() {
    image="$1"
    anchors="$(docker run --rm --entrypoint sh "$image" -c \
        'ls /usr/local/share/ca-certificates/ 2>/dev/null | grep "\.crt$" || true')"
    if [ -n "$anchors" ]; then
        red "$image installs a local trust anchor: $anchors"
        return 1
    fi
    for crt in api/certs/*.crt; do
        [ -f "$crt" ] || continue
        # A full body line of the PEM (64 or 76 characters, as exported): unique to
        # that root, and copied verbatim by update-ca-certificates and by the certifi
        # append, so it appears unchanged in any bundle that absorbed it. Verified
        # against a development image, which carries the root, on 2026-10-10.
        line1="$(tr -d '\r' < "$crt" | sed -n '3p')"
        if [ ${#line1} -lt 64 ]; then
            red "Cannot read a PEM body from $crt"
            return 1
        fi
        hits="$(docker run --rm -e M="$line1" --entrypoint sh "$image" -c \
            'grep -rlsF -e "$M" /etc /usr /srv /app /tmp /root /home 2>/dev/null || true')"
        if [ -n "$hits" ]; then
            red "$image trusts the local root $crt, in:"
            echo "$hits"
            return 1
        fi
    done
    grn "$image: no local root."
}

task_release() {
    push=""
    [ "${1:-}" = "--push" ] && push=1
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        red "Uncommitted changes. A release is exactly a commit: commit or stash first."
        exit 1
    fi
    tag="$(git rev-parse --short=12 HEAD)"
    api_image="$IMAGE_REPO/tracelet-api:$tag"
    caddy_image="$IMAGE_REPO/tracelet-caddy:$tag"

    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    step "Exporting $tag (git archive: no untracked or ignored file can reach an image)"
    mkdir -p "$work/src"
    git archive HEAD | tar -x -C "$work/src"

    # A machine that re-signs HTTPS needs its root to download while building; it goes
    # in as a BuildKit secret, never a file in the context (api/certs/README.md).
    secret=""
    if ls api/certs/*.crt >/dev/null 2>&1; then
        cat api/certs/*.crt > "$work/local-ca.pem"
        secret="--secret id=local_ca,src=$(native_path "$work/local-ca.pem")"
        echo "  local root passed as a build secret: $(ls api/certs/*.crt | tr '\n' ' ')"
    fi

    step "Building $api_image"
    # shellcheck disable=SC2086
    MSYS_NO_PATHCONV=1 docker build --target production $secret \
        -t "$api_image" "$(native_path "$work/src/api")"
    step "Building $caddy_image"
    # shellcheck disable=SC2086
    MSYS_NO_PATHCONV=1 docker build $secret \
        -f "$(native_path "$work/src/web/Dockerfile")" \
        -t "$caddy_image" "$(native_path "$work/src")"

    step "Checking the images for a local root"
    release_check "$api_image"
    release_check "$caddy_image"

    if [ -z "$push" ]; then
        grn "Built and checked $tag. Push with: ./scripts/tl release --push"
        return 0
    fi
    step "Pushing to Docker Hub"
    docker push "$api_image"
    docker push "$caddy_image"
    grn "Released $tag."
    echo "  On the VM:  git fetch && git checkout $(git rev-parse HEAD) && ./scripts/tl deploy"
}

# Read-only. Warns rather than fails: a deploy onto an unprepared host should still
# be possible, and the warning says what `host-setup` would change.
task_host_check() {
    ok=1
    warn() { ylw "  ! $1"; ok=""; }
    swap_kb="$(awk '/SwapTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    [ "${swap_kb:-0}" -ge 1900000 ] || warn "swap is under 2 GB (ADR-0012)"
    [ -f /etc/systemd/journald.conf.d/50-tracelet.conf ] || warn "journald is not capped"
    grep -q 'maxsize 100M' /etc/logrotate.d/rsyslog 2>/dev/null || warn "rsyslog rotation is Debian's weekly default"
    [ "$(cat /proc/sys/vm/swappiness 2>/dev/null)" = "10" ] || warn "vm.swappiness is not 10"
    if systemctl is-active --quiet google-cloud-ops-agent 2>/dev/null; then
        warn "the Ops Agent is running (stopped by owner decision, ADR-0026)"
    fi
    if grep -q '^TRACELET_SITE_ADDRESS=.*\.duckdns\.org' .env 2>/dev/null \
        && [ ! -f /etc/cron.d/tracelet-duckdns ]; then
        warn "the DuckDNS name is not kept pointed at this VM"
    fi
    used="$(df -P / | awk 'NR==2 {print $5}' | tr -d '%')"
    [ "${used:-0}" -lt 80 ] || warn "the root disk is ${used}% full"
    if [ -n "$ok" ]; then grn "Host baseline: OK"; else ylw "Run: ./scripts/tl host-setup"; fi
}

# Applies the host baseline (ADR-0026, deploy/host/). Idempotent; needs sudo.
task_host_setup() {
    step "journald: capped at 200 MB"
    sudo install -D -m 0644 deploy/host/journald-tracelet.conf \
        /etc/systemd/journald.conf.d/50-tracelet.conf
    sudo systemctl restart systemd-journald
    step "rsyslog: daily or at 100 MB, four kept"
    sudo install -m 0644 deploy/host/logrotate-rsyslog /etc/logrotate.d/rsyslog
    step "vm.swappiness: 10 (drop page cache before swapping program memory)"
    sudo install -m 0644 deploy/host/sysctl-tracelet.conf /etc/sysctl.d/60-tracelet.conf
    echo 10 | sudo tee /proc/sys/vm/swappiness > /dev/null
    step "Ops Agent: stopped and disabled, kept installed"
    if systemctl list-unit-files google-cloud-ops-agent.service >/dev/null 2>&1; then
        sudo systemctl disable --now google-cloud-ops-agent.service 2>/dev/null || true
    fi
    if grep -q '^TRACELET_SITE_ADDRESS=.*\.duckdns\.org' .env 2>/dev/null; then
        step "DuckDNS: re-pointed at boot and every five minutes"
        sudo install -d -m 0700 /etc/tracelet
        sudo install -d -m 0755 /var/lib/tracelet
        if ! sudo test -f /etc/tracelet/duckdns.curl; then
            ylw "  Create /etc/tracelet/duckdns.curl (root, 0600) with one line:"
            ylw "    url = \"https://www.duckdns.org/update?domains=<name>&token=<token>&ip=\""
            ylw "  then re-run host-setup."
        else
            sudo chmod 0600 /etc/tracelet/duckdns.curl
            sudo install -m 0644 deploy/host/duckdns-cron /etc/cron.d/tracelet-duckdns
            sudo sh -c 'curl -fsS --max-time 20 -K /etc/tracelet/duckdns.curl -o /var/lib/tracelet/duckdns.last'
            echo "  DuckDNS answered: $(cat /var/lib/tracelet/duckdns.last)"
        fi
    fi
    task_host_check
}

# Generates fresh production secrets on the VM (ADR-0026, item 7). Writes .env from
# .env.example and secrets/ip_key; prints the NAMES of what it made, never a value.
task_secrets() {
    site="${1:-}"
    if [ -z "$site" ]; then red "Usage: tl secrets <site address>   e.g. tl secrets tracelet.duckdns.org"; exit 1; fi
    if [ -e .env ] || [ -e secrets/ip_key ]; then
        red ".env or secrets/ip_key already exists. Refusing to overwrite a secret."
        exit 1
    fi
    command -v openssl >/dev/null 2>&1 || { red "openssl is required"; exit 1; }
    hex() { openssl rand -hex "$1"; }
    umask 077
    pg="$(hex 24)"; app="$(hex 24)"; maint="$(hex 24)"; mig="$(hex 24)"
    cp .env.example .env
    # Values are hex, so they need no escaping in sed.
    sed -i \
        -e "s|^TRACELET_ENV=.*|TRACELET_ENV=production|" \
        -e "s|^TRACELET_SITE_ADDRESS=.*|TRACELET_SITE_ADDRESS=$site|" \
        -e "s|^TRACELET_BEHIND_CLOUDFLARE=.*|TRACELET_BEHIND_CLOUDFLARE=false|" \
        -e "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$pg|" \
        -e "s|^TRACELET_DB_APP_PASSWORD=.*|TRACELET_DB_APP_PASSWORD=$app|" \
        -e "s|^TRACELET_DB_MAINT_PASSWORD=.*|TRACELET_DB_MAINT_PASSWORD=$maint|" \
        -e "s|^TRACELET_DB_MIGRATE_PASSWORD=.*|TRACELET_DB_MIGRATE_PASSWORD=$mig|" \
        -e "s|tracelet_app:change-me-app@|tracelet_app:$app@|" \
        -e "s|tracelet_migrate:change-me-migrate@|tracelet_migrate:$mig@|" \
        -e "s|^TRACELET_SESSION_SECRET=.*|TRACELET_SESSION_SECRET=$(hex 32)|" \
        -e "s|^TRACELET_PEPPER_STABLE=.*|TRACELET_PEPPER_STABLE=$(hex 32)|" \
        -e "s|^TRACELET_PEPPER_ROTATING=.*|TRACELET_PEPPER_ROTATING=$(hex 32)|" \
        -e "s|^TRACELET_PEPPER_FP=.*|TRACELET_PEPPER_FP=$(hex 32)|" \
        .env
    {
        echo ""
        echo "# === Release host (ADR-0026) ==============================================="
        echo "# Every compose command on this host uses the production override."
        echo "COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml"
        echo "TRACELET_IMAGE_REPO=$IMAGE_REPO"
        echo "# Set by ./scripts/tl deploy to the checked-out commit."
        echo "TRACELET_IMAGE_TAG="
    } >> .env
    mkdir -p secrets
    hex 32 > secrets/ip_key
    # The api runs as uid 10001 (api/Dockerfile) and must read the key; nobody else.
    chmod 0400 secrets/ip_key
    if [ "$(uname -s)" = "Linux" ]; then sudo chown 10001:10001 secrets/ip_key; fi
    grn "Generated: POSTGRES_PASSWORD, the three DB role passwords, TRACELET_SESSION_SECRET,"
    grn "the three peppers, and secrets/ip_key. .env is mode 0600."
    ylw "Now, before anything else:"
    ylw "  1. Fill in by hand: TRACELET_TELEGRAM_BOT_TOKEN (the ROTATED one),"
    ylw "     TRACELET_TELEGRAM_OWNER_CHAT_ID, MAXMIND_ACCOUNT_ID, MAXMIND_LICENSE_KEY,"
    ylw "     IP2LOCATION_TOKEN, IPINFO_TOKEN."
    ylw "  2. Copy .env and secrets/ip_key OFF this VM, into your password manager."
    ylw "     Without them a backup restores to unreadable ip_enc (ADR-0007, R11)."
}

task_deploy() {
    require_env
    if ! is_release_host; then
        red "Not a release host: .env has no TRACELET_IMAGE_TAG. See ./scripts/tl secrets."
        exit 1
    fi
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        red "The checkout has local changes. Deploy a clean commit."
        exit 1
    fi
    tag="$(git rev-parse --short=12 HEAD)"
    step "Host baseline"
    task_host_check
    step "Deploying $tag"
    sed -i "s|^TRACELET_IMAGE_TAG=.*|TRACELET_IMAGE_TAG=$tag|" .env
    $DC pull api caddy
    # Tags are mutable on Docker Hub; the digest is what actually ran. Recorded with the
    # outcome, so the history never lists a failed attempt as the running version.
    mkdir -p .deploy
    digests="$(docker image inspect --format '  {{index .RepoDigests 0}}' \
        "$IMAGE_REPO/tracelet-api:$tag" "$IMAGE_REPO/tracelet-caddy:$tag")"
    record() {
        printf '%s %s %s\n%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$1" "$digests" \
            >> .deploy/history
    }
    trap 'record FAILED' EXIT
    $DC up -d db
    task_waitdb
    step "Migrations (the new image)"
    task_migrate
    step "Starting"
    $DC up -d --remove-orphans db api caddy
    i=0
    while [ $i -lt 60 ]; do
        if [ "$($DC ps --format '{{.Health}}' api 2>/dev/null)" = "healthy" ]; then
            trap - EXIT
            record deployed
            grn "Deployed $tag. https://$(grep '^TRACELET_SITE_ADDRESS=' .env | cut -d= -f2)"
            tail -n 3 .deploy/history
            return 0
        fi
        i=$((i + 1))
        sleep 2
    done
    red "The api did not become healthy within 120 s."
    $DC logs --tail=60 api
    exit 1
}

# Security headers and CSP against a deployed URL, three browser engines (qa/live_check.py).
# No sign-in, no visit. On a machine that re-signs HTTPS (a local root in api/certs/), the
# browsers must ignore certificate errors, and the report says the certificate was not
# verified.
task_live_check() {
    url="${1:-}"
    if [ -z "$url" ]; then red "Usage: tl live-check https://<site>"; exit 1; fi
    insecure=0
    ls api/certs/*.crt >/dev/null 2>&1 && insecure=1
    MSYS_NO_PATHCONV=1 $DC --profile live run --rm --no-deps -T \
        -e TRACELET_LIVE_INSECURE="$insecure" live-check python /qa/live_check.py "$url"
}

# The M9 load test (ADR-0027), from a workstation. `full` needs the owner to raise the
# capture limits first and restore them after; `limits` runs at the defaults.
task_loadtest() {
    url="${1:-}"; slug="${2:-}"; mode="${3:-full}"
    if [ -z "$url" ] || [ -z "$slug" ]; then
        red "Usage: tl loadtest https://<site> <slug> [full|limits]"; exit 1
    fi
    # k6's own -e flags: container environment does not reliably reach __ENV.
    MSYS_NO_PATHCONV=1 $DC --profile live run --rm --no-deps -T k6 run --quiet \
        -e BASE="$url" -e SLUG="$slug" -e MODE="$mode" \
        -e DESTINATION="${TRACELET_LOADTEST_DESTINATION:-https://example.com}" \
        /scripts/capture.js
}

task_help() {
    cat <<'EOF'
tl — Tracelet task runner

  bootstrap   build images, migrate, create the first owner admin
  up          start everything (docker compose up -d)
  down        stop everything
  verify      the full CI gate, locally: 14 checks
  migrate     alembic upgrade head
  revision M  create a migration:  tl revision "add visits table"
  fmt         ruff format + ruff --fix + prettier --write
  openapi     regenerate the OpenAPI document and the TypeScript client
  logs [svc]  follow logs
  ps          container status
  psql        open a psql shell on the database
  db-setup    one-time superuser setup for the restore check (ADR-0022)
  shell       open a shell in the api container
  tunnel      development only: a public address for a phone (ADR-0025)
  release [--push]  build release images from HEAD, check, push to Docker Hub (ADR-0026)
  secrets SITE      on a new VM: fresh production .env and secrets/ip_key
  host-setup        on the VM: apply the host baseline (deploy/host/, needs sudo)
  host-check        on the VM: check the host baseline, read-only
  deploy            on the VM: pull this commit's images, migrate, start
  live-check URL    headers and CSP against a deployed URL, three engines
  loadtest URL SLUG [full|limits]  the M9 load test, from a workstation (ADR-0027)
  tunnel-stop stop it
  help        this

Same tasks are available as `make <target>` where make is installed.
EOF
}

# --- dispatch --------------------------------------------------------------

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
    bootstrap)     task_bootstrap ;;
    up)            task_up ;;
    down)          task_down ;;
    verify)        task_verify ;;
    migrate)       task_migrate ;;
    revision)      task_revision "$@" ;;
    fmt|format)    task_fmt ;;
    openapi)       task_openapi ;;
    openapi-check) task_openapi_check ;;
    logs)          task_logs "$@" ;;
    ps)            task_ps ;;
    psql)          task_psql ;;
    db-setup)      task_db_setup ;;
    shell)         task_shell ;;
    tunnel)        task_tunnel ;;
    tunnel-stop)   task_tunnel_stop ;;
    release)       task_release "$@" ;;
    secrets)       task_secrets "$@" ;;
    host-setup)    task_host_setup ;;
    host-check)    task_host_check ;;
    deploy)        task_deploy ;;
    live-check)    task_live_check "$@" ;;
    loadtest)      task_loadtest "$@" ;;
    waitdb)        task_waitdb ;;
    help|-h|--help) task_help ;;
    *) red "Unknown task: $cmd"; echo; task_help; exit 1 ;;
esac
