{
  "components": {
    "schemas": {
      "AdminRole": {
        "description": "Two roles only.\n\n``owner`` performs every destructive and configuration action, and each one\nwrites an audit row (CLAUDE.md invariant 9). ``analyst`` is strictly read-only.",
        "enum": [
          "owner",
          "analyst"
        ],
        "title": "AdminRole",
        "type": "string"
      },
      "AdminStatus": {
        "enum": [
          "pending_enrollment",
          "active",
          "disabled"
        ],
        "title": "AdminStatus",
        "type": "string"
      },
      "AdminSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login At"
          },
          "locked_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locked Until"
          },
          "role": {
            "$ref": "#/components/schemas/AdminRole"
          },
          "status": {
            "$ref": "#/components/schemas/AdminStatus"
          },
          "telegram_verified": {
            "title": "Telegram Verified",
            "type": "boolean"
          },
          "totp_enrolled": {
            "title": "Totp Enrolled",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "status",
          "totp_enrolled",
          "telegram_verified",
          "last_login_at",
          "locked_until",
          "created_at"
        ],
        "title": "AdminSummary",
        "type": "object"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 512,
            "minLength": 1,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "CheckResult": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "detail"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "CreateAdminRequest": {
        "properties": {
          "display_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AdminRole",
            "default": "analyst"
          }
        },
        "required": [
          "email",
          "display_name"
        ],
        "title": "CreateAdminRequest",
        "type": "object"
      },
      "CreateAdminResponse": {
        "properties": {
          "admin": {
            "$ref": "#/components/schemas/AdminSummary"
          },
          "enrollment_expires_at": {
            "format": "date-time",
            "title": "Enrollment Expires At",
            "type": "string"
          },
          "enrollment_url": {
            "title": "Enrollment Url",
            "type": "string"
          }
        },
        "required": [
          "admin",
          "enrollment_url",
          "enrollment_expires_at"
        ],
        "title": "CreateAdminResponse",
        "type": "object"
      },
      "EnrollRequest": {
        "properties": {
          "password": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "EnrollRequest",
        "type": "object"
      },
      "EnrollResponse": {
        "description": "Returned exactly once. The secret and codes are never retrievable again.",
        "properties": {
          "confirm_token": {
            "title": "Confirm Token",
            "type": "string"
          },
          "hint": {
            "title": "Hint",
            "type": "string"
          },
          "otpauth_uri": {
            "title": "Otpauth Uri",
            "type": "string"
          },
          "recovery_codes": {
            "items": {
              "type": "string"
            },
            "title": "Recovery Codes",
            "type": "array"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          }
        },
        "required": [
          "secret",
          "otpauth_uri",
          "recovery_codes",
          "hint",
          "confirm_token"
        ],
        "title": "EnrollResponse",
        "type": "object"
      },
      "EnrollmentTokenResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expires_at"
        ],
        "title": "EnrollmentTokenResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "recovery_codes_remaining": {
            "title": "Recovery Codes Remaining",
            "type": "integer"
          },
          "role": {
            "$ref": "#/components/schemas/AdminRole"
          },
          "session_expires_at": {
            "format": "date-time",
            "title": "Session Expires At",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AdminStatus"
          },
          "telegram_verified": {
            "title": "Telegram Verified",
            "type": "boolean"
          },
          "theme": {
            "title": "Theme",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "totp_enrolled": {
            "title": "Totp Enrolled",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "status",
          "timezone",
          "theme",
          "totp_enrolled",
          "telegram_verified",
          "recovery_codes_remaining",
          "csrf_token",
          "session_id",
          "session_expires_at"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MfaRequest": {
        "properties": {
          "code": {
            "maxLength": 10,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          },
          "mfa_token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Mfa Token",
            "type": "string"
          }
        },
        "required": [
          "mfa_token",
          "code"
        ],
        "title": "MfaRequest",
        "type": "object"
      },
      "MfaTokenResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "mfa_token": {
            "title": "Mfa Token",
            "type": "string"
          }
        },
        "required": [
          "mfa_token",
          "expires_at"
        ],
        "title": "MfaTokenResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "object"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "environment",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RecoveryCodeRequest": {
        "properties": {
          "code": {
            "maxLength": 32,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "title": "RecoveryCodeRequest",
        "type": "object"
      },
      "ResetConfirm": {
        "properties": {
          "new_password": {
            "maxLength": 512,
            "minLength": 1,
            "title": "New Password",
            "type": "string"
          },
          "token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "new_password"
        ],
        "title": "ResetConfirm",
        "type": "object"
      },
      "ResetRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ResetRequest",
        "type": "object"
      },
      "SessionSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "ip_prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Prefix"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "last_seen_at",
          "expires_at",
          "ip_prefix",
          "current"
        ],
        "title": "SessionSummary",
        "type": "object"
      },
      "TelegramVerifyConfirm": {
        "properties": {
          "code": {
            "maxLength": 10,
            "minLength": 4,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "TelegramVerifyConfirm",
        "type": "object"
      },
      "TelegramVerifyStart": {
        "properties": {
          "chat_id": {
            "title": "Chat Id",
            "type": "integer"
          }
        },
        "required": [
          "chat_id"
        ],
        "title": "TelegramVerifyStart",
        "type": "object"
      },
      "TotpConfirmRequest": {
        "properties": {
          "code": {
            "maxLength": 10,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          },
          "confirm_token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Confirm Token",
            "type": "string"
          }
        },
        "required": [
          "confirm_token",
          "code"
        ],
        "title": "TotpConfirmRequest",
        "type": "object"
      },
      "UpdateAdminRequest": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AdminRole"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AdminStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "UpdateAdminRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Two surfaces sharing one deployment: a public capture surface (`/r/{slug}`) and an authenticated admin API (`/api/v1/*`). See docs/API.md.",
    "summary": "Visitor intelligence platform",
    "title": "Tracelet",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admins": {
      "get": {
        "operationId": "list_admins_api_v1_admins_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminSummary"
                  },
                  "title": "Response List Admins Api V1 Admins Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List admins",
        "tags": [
          "admins"
        ]
      },
      "post": {
        "description": "Creates a pending account and returns a one-time enrollment URL. **No password is ever set here** -- the invitee sets their own through the link, so no default password exists and an owner cannot impersonate a colleague.",
        "operationId": "create_admin_api_v1_admins_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdminRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAdminResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Invite an admin",
        "tags": [
          "admins"
        ]
      }
    },
    "/api/v1/admins/{admin_id}": {
      "delete": {
        "description": "Refused if it would leave zero active owners (409 LAST_OWNER).",
        "operationId": "delete_admin_api_v1_admins__admin_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "admin_id",
            "required": true,
            "schema": {
              "title": "Admin Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete an admin",
        "tags": [
          "admins"
        ]
      },
      "get": {
        "operationId": "get_admin_api_v1_admins__admin_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "admin_id",
            "required": true,
            "schema": {
              "title": "Admin Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One admin",
        "tags": [
          "admins"
        ]
      },
      "patch": {
        "description": "Refuses any change that would leave zero active owners. Enforced by a deferred constraint trigger in the database as well as checked here, because two concurrent demotions would each pass an application-level count.",
        "operationId": "update_admin_api_v1_admins__admin_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "admin_id",
            "required": true,
            "schema": {
              "title": "Admin Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAdminRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update role, status or display name",
        "tags": [
          "admins"
        ]
      }
    },
    "/api/v1/admins/{admin_id}/enrollment-token": {
      "post": {
        "operationId": "new_enrollment_token_api_v1_admins__admin_id__enrollment_token_post",
        "parameters": [
          {
            "in": "path",
            "name": "admin_id",
            "required": true,
            "schema": {
              "title": "Admin Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue a fresh enrollment link",
        "tags": [
          "admins"
        ]
      }
    },
    "/api/v1/auth/enroll": {
      "post": {
        "description": "Sets the first password and returns the TOTP secret plus ten recovery codes. **Returned exactly once** -- neither is retrievable afterwards. The account becomes active only after /totp/confirm proves the authenticator works.",
        "operationId": "enroll_api_v1_auth_enroll_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete enrolment with a one-time token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Verifies the password and returns a short-lived MFA token. **Not** a session: TOTP is mandatory, so no route is reachable until step 2 completes. Failures are indistinguishable for wrong password, unknown account, disabled account and incomplete enrolment.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Step 1 of 2: password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
